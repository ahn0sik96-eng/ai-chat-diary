# Supabase 프로젝트 설정값 (Project Settings > API)
# 이 값들은 클라이언트에 노출되어도 안전한 공개 키입니다.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 아래 값은 앱이 아니라 Supabase Edge Function secret 으로만 설정합니다.
# (절대 EXPO_PUBLIC_ 접두사로 두지 마세요. 앱 번들에 노출됩니다.)
#   supabase secrets set GROK_API_KEY=xai-xxxxxxxx
#   supabase secrets set GROK_MODEL=grok-3
